{
  "name": "command-centre",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "preview:browser": "vite --mode browser",
    "build:phone": "vite build --mode phone --outDir cloud/public --emptyOutDir --base ./ && node -e \"require('fs').renameSync('cloud/public/phone.html','cloud/public/index.html')\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource/barlow-condensed": "^5.1.0",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-autostart": "^2.3.0",
    "@tauri-apps/plugin-opener": "^2.2.6",
    "qrcode-generator": "^1.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-grid-layout": "^1.5.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "sql.js": "^1.13.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3",
    "@types/sql.js": "^1.4.9"
  }
